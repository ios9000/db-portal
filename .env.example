# Copy to .env (gitignored) and adjust if needed. Values below work with infra/compose.yaml.

# Portal database (docker-compose dev)
PORTAL_DB_HOST=127.0.0.1
PORTAL_DB_PORT=5432
PORTAL_DB_USER=portal
PORTAL_DB_PASSWORD=change-me-dev-only
PORTAL_DB_NAME=portal

# SMTP — mailpit catcher (UI: http://localhost:8025)
PORTAL_SMTP_HOST=127.0.0.1
PORTAL_SMTP_PORT=1025
PORTAL_SMTP_FROM=portal@db-portal.local
# Comma-separated DBA list for failure/cancel mail; EMPTY = notifications off.
PORTAL_NOTIFY_TO=dba-team@db-portal.local

# Portal server
PORTAL_HTTP_ADDR=:8080
# Portal root used to build run links in notification mail.
PORTAL_BASE_URL=http://localhost:8080
