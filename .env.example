# Copy to .env (gitignored) and adjust if needed. Values below work with infra/compose.yaml.

# Portal database (docker-compose dev)
PORTAL_DB_HOST=127.0.0.1
PORTAL_DB_PORT=5432
PORTAL_DB_USER=portal
PORTAL_DB_PASSWORD=change-me-dev-only
PORTAL_DB_NAME=portal

# SMTP — mailpit catcher (UI: http://localhost:8025)
PORTAL_SMTP_HOST=127.0.0.1
PORTAL_SMTP_PORT=1025
PORTAL_SMTP_FROM=portal@db-portal.local
# Comma-separated DBA list for failure/cancel mail; EMPTY = notifications off.
PORTAL_NOTIFY_TO=dba-team@db-portal.local

# Portal server
PORTAL_HTTP_ADDR=:8080
# Portal root used to build run links in notification mail.
PORTAL_BASE_URL=http://localhost:8080

# AuthN (SPEC-020). Mode: ldap (default, fails closed) | fake (dev users) | off (bypass, demo only).
PORTAL_AUTH_MODE=fake
PORTAL_LDAP_URL=
PORTAL_LDAP_BIND_TEMPLATE=
PORTAL_LDAP_INSECURE=false
# bcrypt hash; empty = break-glass account disabled
PORTAL_BREAKGLASS_HASH=
PORTAL_SESSION_TTL=12h
PORTAL_COOKIE_SECURE=false

# --- Concurrency locks (WU-042, SPEC-042) ----------------------------------
# All have safe defaults; the compose dev stack needs none of them. Shown here
# for shape. Instance-lock backstop TTL (a still-live holder is never stolen);
# and the self-target denylist (comma-separated, unioned with PORTAL_DB_NAME —
# so the portal DB is protected out of the box even when empty).
PORTAL_LOCK_TTL=30m
PORTAL_PROTECTED_INSTANCES=

# --- Maintenance & retention (WU-044, SPEC-044, ADR-013) -------------------
# Sweep cadence (non-positive disables the loop); max age of a `standard`
# artifact before reap (non-positive DISABLES the reap — a zero would reap
# everything; `safety` artifacts are never reaped); audit retention is
# OBSERVATIONAL only (append-only ledgers are retained in-DB, logged when the
# oldest event exceeds it). Go duration units only (2160h = 90d, 8760h = 365d).
PORTAL_MAINTENANCE_INTERVAL=1h
PORTAL_ARTIFACT_RETENTION=2160h
PORTAL_AUDIT_RETENTION=8760h

# --- Semaphore (WU-033, SPEC-033 mini-ADR 7) -------------------------------
# Compose `semaphore` service (BoltDB dialect, dev only). Secrets below are
# SHAPE ONLY — never commit real values; real dev values live in .env
# (gitignored). Admin creds are only consumed on the semaphore_config/
# semaphore_data volumes' first boot (admin auto-created then).
SEMAPHORE_ADMIN=admin
SEMAPHORE_ADMIN_PASSWORD=change-me-dev-only
SEMAPHORE_ADMIN_NAME="Portal Admin"
SEMAPHORE_ADMIN_EMAIL=admin@db-portal.local
# base64 of 32 random bytes, e.g. `openssl rand -base64 32`
SEMAPHORE_ACCESS_KEY_ENCRYPTION=base64-32-random-bytes

# Portal-side (read by the Go SemaphoreAdapter — WU-033).
# Mode: mock (default, forever-default per ADR-002) | semaphore (opt-in).
PORTAL_ENGINE_NONPROD=mock
PORTAL_SEMAPHORE_URL=http://127.0.0.1:3000
# Semaphore project that holds the portal's templates (task API paths are
# /api/project/{id}/tasks). infra/semaphore-bootstrap.sh creates project 1.
PORTAL_SEMAPHORE_PROJECT_ID=1
# Semaphore API token for the portal user — created by
# infra/semaphore-bootstrap.sh (prints it at the end); NOT the admin password.
PORTAL_SEMAPHORE_API_TOKEN=
# Shared secret for POST /api/engine/semaphore/webhook (hmac.Equal-compared).
PORTAL_SEMAPHORE_WEBHOOK_SECRET=change-me-dev-only
# Playbook tag -> Semaphore template id, comma-separated, e.g. smoke:1,dump:3
PORTAL_SEMAPHORE_TEMPLATES=smoke:1
PORTAL_SEMAPHORE_POLL_INTERVAL=3s

# --- Dump target (WU-034, SPEC-034) ----------------------------------------
# The compose `pgtarget` Postgres that playbooks/dump.yml backs up. These
# creds are TARGET creds: they live engine-side ONLY (ADR-004) — the Go portal
# never reads them. infra/semaphore-bootstrap.sh injects them into the
# Semaphore "pgtarget-env" Environment; pg_dump reads them via libpq. SHAPE
# ONLY here; real dev values live in .env (gitignored).
PGTARGET_DB_NAME=appdb
PGTARGET_DB_USER=appuser
PGTARGET_DB_PASSWORD=change-me-dev-only

# --- Object storage (WU-035, SPEC-035) -------------------------------------
# Compose `minio` — the real home for dump artifact bytes (O-1). ROOT_USER/
# ROOT_PASSWORD create the minio admin (compose) AND, by default, are the creds
# the dump upload uses. The Go portal NEVER reads these — the bootstrap folds
# them into the Semaphore "pgtarget-env" Environment as the MC_HOST_dbportal
# alias `mc` reads (engine-side only, ADR-004, mini-ADR 4). SHAPE ONLY here;
# real dev values live in .env (gitignored). DBPORTAL_BUCKET is not a secret.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-dev-only
DBPORTAL_BUCKET=dbportal-artifacts
# Engine-side connection (optional overrides; default to the compose facts +
# the root creds above). MINIO_ENDPOINT is the compose-network address.
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me-dev-only
