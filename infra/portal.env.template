# db-portal deploy config template (WU-046) — copy to /etc/dbportal/portal.env
# on the pilot host, fill in the real values, and `chmod 0640 root:dbportal`.
# SHAPE ONLY — never commit real secrets (same discipline as .env.example).
# systemd reads this as the process env (EnvironmentFile=); the portal reads
# config from the process env, so NO .env file is involved on the host (the
# unit sets PORTAL_DOTENV= to disable the search). Lines are KEY=VALUE, no
# quotes, no `export`.
#
# [REQUIRED] must be set or the portal fails closed at boot with a clear error
# (config.Validate — ldap mode). [recommended] should be set for a real pilot.

# --- Portal database -------------------------------------------------------
PORTAL_DB_HOST=127.0.0.1            # [REQUIRED] portal-DB host
PORTAL_DB_PORT=5432
PORTAL_DB_USER=portal               # [REQUIRED]
PORTAL_DB_PASSWORD=CHANGEME         # [REQUIRED] portal-DB password
PORTAL_DB_NAME=portal

# --- HTTP ------------------------------------------------------------------
PORTAL_HTTP_ADDR=:8080              # bind addr; put TLS (nginx/caddy) in front
PORTAL_BASE_URL=https://dbportal.example.com   # [recommended] used in mail links

# --- AuthN (SPEC-020) ------------------------------------------------------
# Pilot runs REAL auth: ldap. `off` is demo-only (full bypass) and must never
# ship to a pilot; `fake` is dev/CI.
PORTAL_AUTH_MODE=ldap                              # [REQUIRED] ldap for a pilot
PORTAL_LDAP_URL=ldaps://ad.corp.example.com:636    # [REQUIRED in ldap] TLS: ldaps:// or StartTLS
PORTAL_LDAP_BIND_TEMPLATE=%s@corp.example.com      # [REQUIRED in ldap] UPN or full-DN template
PORTAL_LDAP_INSECURE=false                          # keep false: dev-only TLS opt-out
# Break-glass: one local emergency account (username `break-glass`) for when AD
# is down. bcrypt hash only — empty disables it. Its use is alarmed to
# PORTAL_NOTIFY_TO (WU-046). Generate: `htpasswd -bnBC 10 "" 'pw' | tr -d ':\n'`.
PORTAL_BREAKGLASS_HASH=             # [recommended] bcrypt hash, NEVER the plaintext
PORTAL_SESSION_TTL=12h
# Behind TLS the session cookie MUST be Secure. Leave true for a pilot; the
# boot logs a Warn if this is false in ldap mode (cookie could travel plain HTTP).
PORTAL_COOKIE_SECURE=true           # [recommended] true when TLS terminates in front

# --- Notifications (SPEC-014) ---------------------------------------------
# Failure/cancel/chain-halt mail AND the break-glass alarm go here. Empty
# PORTAL_NOTIFY_TO = notifications off (and no break-glass mail alarm).
PORTAL_SMTP_HOST=smtp.corp.example.com
PORTAL_SMTP_PORT=25
PORTAL_SMTP_FROM=db-portal@example.com
PORTAL_NOTIFY_TO=dba-team@example.com   # [recommended] comma-separated DBA list

# --- Engine (ADR-002) ------------------------------------------------------
# Pilot default = mock (forever-default). Real Semaphore is opt-in and brings
# its own PORTAL_SEMAPHORE_* + engine-side target/object-store creds (ADR-004,
# see .env.example) — out of scope for the mock pilot.
PORTAL_ENGINE_NONPROD=mock

# --- Concurrency locks (SPEC-042) -----------------------------------------
PORTAL_LOCK_TTL=30m
# Self-target denylist (comma-separated), unioned with PORTAL_DB_NAME. Add any
# instance the portal must never target (e.g. its own DB host, secret stores).
PORTAL_PROTECTED_INSTANCES=

# --- Maintenance & retention (SPEC-044, ADR-013) --------------------------
PORTAL_MAINTENANCE_INTERVAL=1h      # sweep cadence; non-positive disables the loop
PORTAL_ARTIFACT_RETENTION=2160h     # 90d; reap `standard` artifacts past this (non-positive DISABLES)
PORTAL_AUDIT_RETENTION=8760h        # 365d; OBSERVATIONAL only (ledgers are append-only, retained in-DB)
# OBJECT-STORE BYTES (real engine only): the portal reaps the registry ROW; the
# object store must reap the BYTES. Configure a bucket lifecycle-expiry rule
# matching PORTAL_ARTIFACT_RETENTION, with `safety` artifacts in a
# lifecycle-EXEMPT key space (ADR-004/ADR-013 — the portal never issues `mc rm`).
# Under the mock pilot `location` is NULL, so there is nothing to expire.
