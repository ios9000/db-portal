#!/usr/bin/env sh
# Fast gate on staged areas only; the full gate is `npm run check`.
set -e
export PATH="$HOME/.local/bin:$PATH"
staged=$(git diff --cached --name-only --diff-filter=ACM)
if echo "$staged" | grep -q '^backend/.*\.py$'; then
  echo "pre-commit: backend (ruff check + format)"
  (cd backend && uv run ruff check . && uv run ruff format --check .)
fi
if echo "$staged" | grep -q '^frontend/src/'; then
  echo "pre-commit: frontend (prettier + eslint)"
  (cd frontend && npx prettier --check src && npm run --silent lint)
fi
