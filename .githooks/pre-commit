#!/usr/bin/env sh
# Fast gate on staged areas only; the full gate is `npm run check`.
set -e
export PATH="$PATH:/usr/local/go/bin:$HOME/go/bin"
staged=$(git diff --cached --name-only --diff-filter=ACM)
if echo "$staged" | grep -q '^backend/.*\.go$'; then
  echo "pre-commit: backend (golangci-lint run + fmt check)"
  (cd backend && golangci-lint run ./... && golangci-lint fmt --diff ./...)
fi
if echo "$staged" | grep -q '^frontend/src/'; then
  echo "pre-commit: frontend (prettier + lint)"
  (cd frontend && npx prettier --check src && npm run --silent lint)
fi
